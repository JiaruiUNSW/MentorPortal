# Copy to a private .env.production; never commit real runtime settings.
PORTAL_MODE=live
APP_ORIGIN=http://127.0.0.1:3100
DATA_DIR=./data
TRUST_PROXY=false
MENTOR_LIVE_WRITES_ENABLED=false
# Optional independent redemption pause. Unset/true retains the existing behavior.
# MENTOR_REDEEM_ENABLED=false
MENTOR_CACHE_ENABLED=true
MENTOR_CACHE_PRIVATE_TTL_HOURS=24
MENTOR_CACHE_CATALOG_TTL_HOURS=48
MENTOR_CACHE_MAX_STALE_HOURS=72
# Required comma-separated SharePoint User.ID scope for the initial pilot.
# Only approved IDs enabled by the upstream adapter will be synchronized.
MENTOR_SYNC_ALLOWED_USER_IDS=
# Set the exact HTTPS origin before exposing the service through a proxy.
# TRUST_PROXY=true is only for an isolated backend behind a proxy that overwrites X-Real-IP.
# MENTOR_BRIDGE_KEY and signed MENTOR_*_URL values belong only in server secrets.
MENTOR_BRIDGE_KEY=
MENTOR_READ_URL=
# Populate only after the corresponding native adapters have been verified.
MENTOR_ATTENDANCE_URL=
MENTOR_REPORT_URL=
MENTOR_EXPENSE_URL=
MENTOR_ATTACHMENT_URL=
MENTOR_PROFILE_URL=
MENTOR_REDEEM_URL=
MENTOR_TICKET_URL=
# Optional on a brand-new installation; remove after first administrator setup.
# SETUP_TOKEN=
# Optional dedicated Authentik USSO client. Keep disabled until separately configured.
MENTOR_USSO_ENABLED=false
MENTOR_USSO_ISSUER=https://login.jiarui.academy/application/o/mentor-portal/
MENTOR_USSO_CLIENT_ID=
MENTOR_USSO_CLIENT_SECRET=
# Exact production callback: https://mentor-portal.com/api/auth/usso/callback
# For USSO, APP_ORIGIN must be https://mentor-portal.com. Never reuse another app's secret.
